[
 {
  "text": "雨停在空空的月台上　我還在等你回來",
  "start": 2.7243,
  "end": 8.7539,
  "notes": 20,
  "chars": 16
 },
 {
  "text": "那年說好的夏天　被風吹散了",
  "start": 9.3646,
  "end": 15.163,
  "notes": 18,
  "chars": 12
 },
 {
  "text": "燈一盞一盞地暗了",
  "start": 16.1946,
  "end": 19.6452,
  "notes": 12,
  "chars": 8
 },
 {
  "text": "別走",
  "start": 20.3419,
  "end": 20.9792,
  "notes": 2,
  "chars": 2
 },
 {
  "text": "你的背影越來越遠",
  "start": 21.4683,
  "end": 25.0316,
  "notes": 9,
  "chars": 8
 },
 {
  "text": "我把想念折成紙船　放進那條河",
  "start": 25.5652,
  "end": 30.2905,
  "notes": 15,
  "chars": 13
 },
 {
  "text": "它不會再靠岸",
  "start": 30.8241,
  "end": 33.2164,
  "notes": 7,
  "chars": 6
 },
 {
  "text": "天涯那麼大　哪裡有我的家",
  "start": 34.0494,
  "end": 38.6264,
  "notes": 12,
  "chars": 11
 },
 {
  "text": "啊",
  "start": 39.1482,
  "end": 39.7292,
  "notes": 1,
  "chars": 1
 },
 {
  "text": "只剩一首歌陪我",
  "start": 40.5889,
  "end": 42.747,
  "notes": 8,
  "chars": 7
 },
 {
  "text": "如果你還記得那段旋律　就輕輕地哼一遍給風聽",
  "start": 44.6739,
  "end": 51.8151,
  "notes": 24,
  "chars": 20
 },
 {
  "text": "我在這裡等",
  "start": 52.4525,
  "end": 53.9525,
  "notes": 5,
  "chars": 5
 },
 {
  "text": "晚安",
  "start": 54.4979,
  "end": 55.3576,
  "notes": 2,
  "chars": 2
 }
]